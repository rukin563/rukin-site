---
import { t, formatBRL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  art: {
    slug: string;
    title: { pt: string; en: string };
    year: string;
    medium: { pt: string; en: string };
    size: { pt: string; en: string };
    image: string;
    status: string; // available | sold | private | none (no label)
    price: number | null;
  };
  href?: string; // when set, the photo and title link to this page (the work's shop page)
  image?: string; // show another photo of the same work instead of its main one
  note?: string; // extra first caption line, e.g. where a mural was made
}

const { lang, art, href, image, note } = Astro.props;
const tr = t(lang);
const statusLabels: Record<string, string> = {
  available: tr('art.available'),
  sold: tr('art.sold'),
  private: tr('art.private'),
};
const statusLabel = statusLabels[art.status];
const heading = `${art.title[lang]}, ${art.year}`;
---

<!-- Only the main photo gets the id, so /obras#slug jumps to one place. -->
<figure class="art" id={image ? undefined : art.slug}>
  {href ? (
    <a class="open" href={href} tabindex="-1" aria-hidden="true">
      <img src={image ?? art.image} alt="" loading="lazy" decoding="async" />
    </a>
  ) : (
    <img src={image ?? art.image} alt={heading} loading="lazy" decoding="async" />
  )}
  <figcaption>
    {note && <span class="note">{note}</span>}
    <span class="title">{href ? <a href={href}>{heading}</a> : heading}</span>
    <span class="meta">{art.medium[lang]}</span>
    <span class="meta">{art.size[lang]}</span>
    {statusLabel && (
      <span class:list={['status', art.status]}>
        {statusLabel}{art.status === 'available' && art.price ? `, ${formatBRL(art.price)}` : ''}
      </span>
    )}
  </figcaption>
</figure>

<style>
  .art { margin: 0 0 2.5rem; break-inside: avoid; }
  img { width: 100%; box-shadow: 0 1px 0 var(--line); }
  figcaption { display: grid; gap: 0.1rem; padding-top: 0.75rem; font-size: 0.95rem; }
  .title { font-weight: 600; }
  .title a { color: inherit; text-decoration: none; }
  .title a:hover, .open:hover + figcaption .title a { color: var(--link); }
  .open img { transition: filter 0.15s; }
  .open:hover img { filter: brightness(1.08); }
  .meta, .note { color: var(--muted); }
  .status { font-size: 0.875rem; color: var(--muted); margin-top: 0.15rem; }
  .status.available { color: var(--link); font-weight: 600; }
  .status.sold { color: var(--sold); }
</style>
