---
// Calendar order form. The buyer picks a quantity and fills in delivery details;
// the form is sent to you through Formspree, then the browser goes to the
// Mercado Pago link for the chosen quantity. Links and prices: calendar.json.
import { t, formatBRL, routes, type Lang } from '../i18n/ui';
import calendar from '../data/calendar.json';
import site from '../data/site.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
// Options whose Mercado Pago link is still a placeholder (SEU_…) are hidden,
// so nobody can pick an option that can't be paid yet.
const options = calendar.options.filter((opt) => !opt.link.includes('SEU_'));
const errorText = tr('order.error').replace('{email}', site.email);
---

<form
  id="pedido"
  class="order"
  action={calendar.orderFormAction}
  method="post"
  data-order-form
  data-sending={tr('order.sending')}
  data-error={errorText}
>
  <h2>{tr('order.title')}</h2>
  <p class="intro">{tr('order.intro')}</p>

  <fieldset class="qty">
    <legend>{tr('order.qty')}</legend>
    {options.map((opt, i) => (
      <label class="pick">
        <input
          type="radio"
          name="quantidade"
          value={`${opt.qty} (${formatBRL(opt.price)})`}
          data-qty={opt.qty}
          data-link={opt.link}
          data-price={formatBRL(opt.price)}
          checked={i === 0}
          required
        />
        <span>{opt.qty === 1 ? tr('cal.buyOne') : tr('cal.kit').replace('{n}', String(opt.qty))}</span>
        <strong>{formatBRL(opt.price)}</strong>
      </label>
    ))}
    <p class="note">{tr('cal.shipping')}</p>
  </fieldset>

  <div class="fields">
    <label class="full">{tr('order.name')}<input name="nome" required autocomplete="name" /></label>
    <label class="full">{tr('order.email')}<input name="email" type="email" required autocomplete="email" /></label>
    <!-- Phone and CPF are required: Correios needs them to ship. -->
    <label>{tr('order.whatsapp')}<input name="telefone" type="tel" required autocomplete="tel"
      placeholder="(11) 91234-5678" pattern="(\+?55\s?)?\(?\d{2}\)?\s?9?\d{4}-?\d{4}" title={tr('order.phoneFormat')} /></label>
    <label>{tr('order.cpf')}<input name="cpf" required inputmode="numeric" maxlength="14" placeholder="123.456.789-09"
      pattern="\d{3}\.?\d{3}\.?\d{3}-?\d{2}" title={tr('order.cpfFormat')} /></label>

    <!-- Typing a full CEP fills street, neighbourhood, city and state (ViaCEP, free public service). -->
    <label>{tr('order.cep')}<input name="cep" required inputmode="numeric" maxlength="9" autocomplete="postal-code" placeholder="01310-100" data-cep /></label>
    <label>{tr('order.number')}<input name="numero" required autocomplete="address-line2" /></label>
    <label class="full">{tr('order.street')}<input name="rua" required autocomplete="address-line1" data-cep-street /></label>
    <label class="full">{tr('order.complement')}<input name="complemento" /></label>
    <label class="full">{tr('order.district')}<input name="bairro" required data-cep-district /></label>
    <label>{tr('order.city')}<input name="cidade" required autocomplete="address-level2" data-cep-city /></label>
    <label>{tr('order.state')}<input name="uf" required maxlength="2" autocomplete="address-level1" data-cep-state /></label>
  </div>

  <label class="news">
    <input type="checkbox" name="novidades" value="sim" />
    {tr('order.news')}
  </label>
  <p class="privacy">{tr('order.privacy')} <a href={routes.privacy[lang]} target="_blank">{tr('order.privacyLink')}</a>
    <a href={routes.returns[lang]} target="_blank">{tr('shop.policy')}</a>.</p>

  <input type="hidden" name="produto" value="Calendário 2027" />
  <input type="hidden" name="idioma" value={lang} />
  <input type="hidden" name="_subject" value="Pedido: Calendário 2027" />
  <!-- Spam trap: people never see or fill this; bots do, and Formspree drops those. -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />

  <button type="submit">{tr('order.submit')}</button>
  <p class="status" role="status" data-order-status></p>
</form>

<!-- Shown instead of the form once the order is sent: the buyer pays in a new tab,
     and this page keeps the confirmation for when they come back. -->
<div class="order-done" hidden data-order-done tabindex="-1">
  <h2>{tr('order.doneTitle')}</h2>
  <p>{tr('order.doneText')}</p>
  <a class="button pay" href="#" target="_blank" rel="noopener" data-pay data-label={tr('order.payButton')}></a>
  <div class="after-pay" hidden data-after-pay>
    <h3>{tr('order.afterPayTitle')}</h3>
    <p>{tr('thanks.text')}</p>
    <p class="muted">{tr('thanks.helpQ')}<br />{tr('thanks.help').replace('{email}', site.email)}</p>
    <p><a href={site.instagram} rel="me">{tr('thanks.follow')}: @rukin563</a></p>
  </div>
</div>

<script>
  // All listeners are on the document so they keep working after the PT/EN switch swaps the page.

  // Buy buttons at the top of the page pre-select the quantity here.
  document.addEventListener('click', (e) => {
    const pick = (e.target as Element).closest<HTMLElement>('[data-pick]');
    if (!pick) return;
    const radio = document.querySelector<HTMLInputElement>(`input[name="quantidade"][data-qty="${pick.dataset.pick}"]`);
    if (radio) radio.checked = true;
  });

  // After the buyer opens the payment, show the thank-you text for when they come back.
  document.addEventListener('click', (e) => {
    const pay = (e.target as Element).closest('[data-pay]');
    if (!pay) return;
    pay.closest('[data-order-done]')?.querySelector<HTMLElement>('[data-after-pay]')?.removeAttribute('hidden');
  });

  // CEP autofill.
  document.addEventListener('input', async (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.matches('[data-cep]')) return;
    const cep = input.value.replace(/\D/g, '');
    if (cep.length !== 8) return;
    try {
      const res = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
      const data = await res.json();
      if (data.erro) return;
      const form = input.form!;
      const fill = (sel: string, value: string) => {
        const field = form.querySelector<HTMLInputElement>(sel);
        if (field && value) field.value = value;
      };
      fill('[data-cep-street]', data.logradouro);
      fill('[data-cep-district]', data.bairro);
      fill('[data-cep-city]', data.localidade);
      fill('[data-cep-state]', data.uf);
      form.querySelector<HTMLInputElement>('input[name="numero"]')?.focus();
    } catch {
      // No autofill if the service is down; the buyer just types the address.
    }
  });

  // Send the order to Formspree, then go to the Mercado Pago link for the chosen quantity.
  document.addEventListener('submit', async (e) => {
    const form = e.target as HTMLFormElement;
    if (!form.matches('[data-order-form]')) return;
    e.preventDefault();
    const picked = form.querySelector<HTMLInputElement>('input[name="quantidade"]:checked');
    const status = form.querySelector<HTMLElement>('[data-order-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = form.dataset.sending!;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      // Order saved: swap the form for the payment step.
      const done = form.nextElementSibling as HTMLElement;
      const pay = done.querySelector<HTMLAnchorElement>('[data-pay]')!;
      pay.href = picked!.dataset.link!;
      pay.textContent = pay.dataset.label!.replace('{price}', picked!.dataset.price!);
      form.hidden = true;
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ block: 'start' });
    } catch {
      status.textContent = form.dataset.error!;
      button.disabled = false;
    }
  });
</script>

<style>
  .order { max-width: 36rem; }
  .intro { margin: 0 0 1.5rem; }
  fieldset { border: 0; padding: 0; margin: 0 0 1.5rem; }
  legend, label { font-weight: 500; }
  legend { padding: 0; margin-bottom: 0.5rem; }
  .pick {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    margin-bottom: 0.5rem;
    border: 1.5px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    cursor: pointer;
  }
  .pick:has(input:checked) { border-color: var(--button); }
  .pick input { width: auto; accent-color: var(--button); }
  .pick span { flex: 1; }
  .note { margin: 0.25rem 0 0; font-size: 0.95rem; color: var(--muted); }

  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; }
  .fields label { display: grid; gap: 0.35rem; align-content: start; }
  .fields .full { grid-column: 1 / -1; }
  @media (max-width: 30rem) { .fields { grid-template-columns: 1fr; } }

  .news { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; cursor: pointer; }
  .news input { width: auto; accent-color: var(--button); }
  .privacy { font-size: 0.875rem; color: var(--muted); margin: 0 0 1.25rem; }
  button { font-size: 1.05rem; padding: 0.8rem 1.6rem; }
  button:disabled { opacity: 0.6; cursor: wait; }
  .status { min-height: 1.5em; margin: 0.75rem 0 0; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .order-done { max-width: 36rem; padding: 1.5rem; border: 1.5px solid var(--line); border-radius: 6px; background: var(--paper); outline: none; }
  .order-done h2 { margin-top: 0; }
  .order-done .pay { display: inline-block; font-size: 1.05rem; padding: 0.9rem 1.6rem; margin: 0.5rem 0 0; }
  .after-pay { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .after-pay h3 { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .muted { color: var(--muted); }
</style>
