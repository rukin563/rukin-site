---
// One component renders every page, in either language.
// The page files in src/pages/ only pick which page and language.
import ArtworkCard from './ArtworkCard.astro';
import ProductCard from './ProductCard.astro';
import { t, routes, type Lang, type PageKey } from '../i18n/ui';
import artworks from '../data/artworks.json';
import products from '../data/products.json';
import site from '../data/site.json';
import obras from '../data/obras.json';
import { itemPaths, hasItemPage } from '../data/shop';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const tr = t(lang);
// Newest first; "2024/25" counts as 2024.
const sorted = [...artworks].sort((a, b) => parseInt(b.year) - parseInt(a.year));
const forSale = sorted.filter((a) => a.status === 'available' && a.paymentLink);
const artBySlug = Object.fromEntries(artworks.map((a) => [a.slug, a]));
// The Obras page follows obras.json block by block. Works that follow each other
// are grouped so they sit side by side in a grid.
type Block = (typeof obras.blocks)[number];
const obrasGroups: (Block | { type: 'works'; items: Block[] })[] = [];
for (const block of obras.blocks) {
  const last = obrasGroups.at(-1);
  if (block.type === 'work' && last?.type === 'works') last.items.push(block);
  else if (block.type === 'work') obrasGroups.push({ type: 'works', items: [block] });
  else obrasGroups.push(block);
}
// Section ids for the "Originais / Produtos" jump links at the top of the shop.
const anchors = lang === 'pt' ? { originals: 'originais', products: 'produtos' } : { originals: 'originals', products: 'products' };
// The cover's four picture buttons come from "coverTiles" in site.json:
// the first two above the statement, the next two below. Labels are the menu
// words in ui.ts, so they switch language with the page.
const tiles = site.coverTiles as { page: PageKey; image: string }[];
---

{page === 'home' && (
  <section class="cover">
    {tiles.map((tile, i) => (
      <a class={`tile f${i + 1}`} href={routes[tile.page][lang]}>
        <img src={tile.image} alt="" decoding="async" />
        <span>{tr(`nav.${tile.page}`)}</span>
      </a>
    ))}
    <div class="statement">
      <h1>{tr('home.statement')}</h1>
      <p class="lede">{tr('home.intro')}</p>
      <a class="button quiet" href={routes.gallery[lang]}>{tr('home.seeAll')}</a>
    </div>
  </section>
)}

{page === 'gallery' && (
  <section class="obras">
    <h1>{tr('gallery.title')}</h1>
    {obrasGroups.map((group) => {
      if (group.type === 'works') {
        return (
          <div class="grid">
            {group.items.map((block) => {
              const art = artBySlug[block.slug];
              return (
                <ArtworkCard
                  lang={lang}
                  art={art}
                  image={block.image}
                  href={hasItemPage(art.slug) ? itemPaths(art.slug)[lang] : undefined}
                />
              );
            })}
          </div>
        );
      }
      if (group.type === 'section') return <h2 class="chapter">{group.text[lang]}</h2>;
      if (group.type === 'subheading') return <h3>{group.text[lang]}</h3>;
      if (group.type === 'text') return <p class="essay">{group.text[lang]}</p>;
      return (
        <figure class="view">
          <img src={group.image} alt={group.caption[lang]} loading="lazy" decoding="async" />
          <figcaption>{group.caption[lang]}</figcaption>
        </figure>
      );
    })}
  </section>
)}

{page === 'shop' && (
  <section>
    <h1>{tr('shop.title')}</h1>
    <nav class="jump" aria-label={tr('shop.title')}>
      <a class="button quiet" href={`#${anchors.originals}`}>{tr('shop.originals')}</a>
      <a class="button quiet" href={`#${anchors.products}`}>{tr('shop.prints')}</a>
    </nav>

    <h2 id={anchors.originals}>{tr('shop.originals')}</h2>
    <p class="lede">{tr('shop.originalsIntro')}</p>
    {forSale.length ? (
      <div class="grid">
        {forSale.map((art) => <ArtworkCard lang={lang} art={art} href={itemPaths(art.slug)[lang]} />)}
      </div>
    ) : (
      <p>{tr('shop.empty')}</p>
    )}

    <h2 id={anchors.products}>{tr('shop.prints')}</h2>
    <p class="lede">{tr('shop.printsIntro')}</p>
    <div class="grid">
      {products.map((product) => (
        <ProductCard lang={lang} product={product} href={itemPaths(product.slug)[lang]} />
      ))}
    </div>
  </section>
)}

{page === 'about' && (
  <section class="prose">
    <h1>{tr('about.title')}</h1>
    <figure class="view">
      <img src={site.aboutPhoto.image} alt={site.aboutPhoto.caption[lang]} decoding="async" />
      <figcaption>{site.aboutPhoto.caption[lang]}</figcaption>
    </figure>
    {site.about[lang].map((para) => <p>{para}</p>)}
  </section>
)}

{page === 'bio' && (
  <section class="prose">
    <h1>{tr('bio.title')}</h1>
    <figure class="view">
      <img src={site.bioPhoto} alt={site.artistName} decoding="async" />
    </figure>
    {site.bio[lang].map((para) => <p>{para}</p>)}
    <p><a class="button quiet" href={site.cv[lang]} target="_blank" rel="noopener">{tr('bio.cv')}</a></p>
  </section>
)}

{page === 'contact' && (
  <section class="prose">
    <h1>{tr('contact.title')}</h1>
    <p class="lede">{tr('contact.intro')}</p>
    <form class="contact" action={site.contactFormAction} method="post">
      <label>{tr('contact.name')}<input name="name" required autocomplete="name" /></label>
      <label>{tr('contact.email')}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{tr('contact.message')}<textarea name="message" rows="6" required></textarea></label>
      <input type="hidden" name="_language" value={lang} />
      <button type="submit">{tr('contact.send')}</button>
    </form>
  </section>
)}

<style>
  .lede { color: var(--muted); font-size: 1.15rem; margin: 0 0 2rem; }
  h2 { margin-top: 2.5rem; }
  .grid { columns: 3 18rem; column-gap: 2rem; margin-bottom: 1.5rem; }
  .prose { max-width: 40rem; }

  /* Obras: chapters, essays, exhibition views and works, in the order of obras.json. */
  .chapter { font-size: clamp(1.6rem, 3.5vw, 2.25rem); margin: 4rem 0 1.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .obras h1 + .chapter { margin-top: 1rem; padding-top: 0; border-top: 0; }
  .obras h3 { font-size: 1.15rem; margin: 2.5rem 0 1rem; }
  .essay { margin: 0 0 2rem; }
  .view { margin: 0 0 2rem; max-width: 56rem; }
  .view img { width: 100%; box-shadow: 0 1px 0 var(--line); }
  .view figcaption { padding-top: 0.6rem; font-size: 0.9rem; color: var(--muted); }
  .contact { display: grid; gap: 1rem; }
  .contact label { display: grid; gap: 0.35rem; font-weight: 500; }
  .contact button { justify-self: start; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.5rem 0 1rem; }
  h2[id] { scroll-margin-top: 1.5rem; }

  /* Cover: two works side by side, the statement across the full width, two more works. */
  .cover {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'f1 f2' 'text text' 'f3 f4';
    align-items: center;
  }
  .f1 { grid-area: f1; } .f2 { grid-area: f2; } .f3 { grid-area: f3; } .f4 { grid-area: f4; }
  .statement { grid-area: text; padding: 1rem 0; text-align: center; }
  .statement .lede { margin-left: auto; margin-right: auto; }
  .statement h1 {
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-stretch: 75%;
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }
  .statement .lede { margin-bottom: 1.5rem; }
  /* Picture buttons: square photo with the section name on a white band across the middle. */
  .tile { position: relative; display: block; text-decoration: none; }
  .tile img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; box-shadow: 0 1px 0 var(--line); }
  .tile span {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.55em 0;
    background: rgb(255 255 255 / 0.78);
    color: #17191c;
    text-align: center;
    font-size: clamp(1rem, 2.6vw, 1.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    text-indent: 0.25em; /* balances the letter-spacing so the word stays centred */
    transition: background 0.15s, color 0.15s;
  }
  /* Hover: see-through medium grey band, white text. Lower 0.8 for more see-through,
     but below about 0.7 the white text gets hard to read over bright pictures. */
  .tile:hover span, .tile:focus-visible span { background: rgb(138 141 145 / 0.8); color: #fff; }
</style>
