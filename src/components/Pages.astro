---
// One component renders every page, in either language.
// The page files in src/pages/ only pick which page and language.
import ArtworkCard from './ArtworkCard.astro';
import ProductCard from './ProductCard.astro';
import { t, routes, type Lang, type PageKey } from '../i18n/ui';
import artworks from '../data/artworks.json';
import products from '../data/products.json';
import site from '../data/site.json';
import obras from '../data/obras.json';
import privacy from '../data/privacy.json';
import returns from '../data/returns.json';
import { itemPaths, hasItemPage } from '../data/shop';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const tr = t(lang);
// Newest first; "2024/25" counts as 2024.
const sorted = [...artworks].sort((a, b) => parseInt(b.year) - parseInt(a.year));
const forSale = sorted.filter((a) => a.status === 'available' && a.paymentLink);
const artBySlug = Object.fromEntries(artworks.map((a) => [a.slug, a]));
// The Obras page follows obras.json block by block, on the same 12-column grid as
// the old Google Sites page. "col" says which columns a block covers (lines 1 to 13).
const defaultCol: Record<string, string> = { section: '1 / 13', subheading: '3 / 11' };
const colOf = (block: { type: string; col?: string }) => block.col ?? defaultCol[block.type] ?? '2 / 12';
// Section ids for the "Originais / Produtos" jump links at the top of the shop.
const anchors = lang === 'pt' ? { originals: 'originais', products: 'produtos' } : { originals: 'originals', products: 'products' };
// The cover's four picture buttons come from "coverTiles" in site.json:
// the first two above the statement, the next two below. Labels are the menu
// words in ui.ts, so they switch language with the page.
const tiles = site.coverTiles as { page: PageKey; image: string }[];
---

{page === 'home' && (
  <section class="cover">
    {tiles.map((tile, i) => (
      <a class={`tile f${i + 1}`} href={routes[tile.page][lang]}>
        <img src={tile.image} alt="" decoding="async" />
        <span>{tr(`nav.${tile.page}`)}</span>
      </a>
    ))}
    <div class="statement">
      <div class="quote-block">
        <h1>{tr('home.statement')}</h1>
        <p class="lede">{tr('home.intro')}</p>
      </div>
      <a class="button quiet" href={routes.gallery[lang]}>{tr('home.seeAll')}</a>
    </div>
  </section>
)}

{page === 'gallery' && (
  <section class="obras">
    <!-- Hidden title: invisible, but Google and screen readers still know this is the Obras page. -->
    <h1 class="sr-only">{tr('gallery.title')}</h1>
    <div class="layout">
      {obras.blocks.map((block) => (
        <div class="cell" style={`--col: ${colOf(block)}`}>
          {block.type === 'section' && <h2 class="chapter">{block.text[lang]}</h2>}
          {block.type === 'subheading' && <h3>{block.text[lang]}</h3>}
          {block.type === 'text' && <p class="essay">{block.text[lang]}</p>}
          {block.type === 'view' && (
            <figure class="view">
              <img src={block.image} alt={block.caption[lang]} loading="lazy" decoding="async" />
              <figcaption>{block.caption[lang]}</figcaption>
            </figure>
          )}
          {block.type === 'work' && (
            <ArtworkCard
              lang={lang}
              art={artBySlug[block.slug]}
              image={block.image}
              note={block.note?.[lang]}
              href={hasItemPage(block.slug) ? itemPaths(block.slug)[lang] : undefined}
            />
          )}
        </div>
      ))}
    </div>
  </section>
)}

{page === 'shop' && (
  <section>
    <h1>{tr('shop.title')}</h1>
    <nav class="jump" aria-label={tr('shop.title')}>
      <a class="button quiet" href={`#${anchors.originals}`}>{tr('shop.originals')}</a>
      <a class="button quiet" href={`#${anchors.products}`}>{tr('shop.prints')}</a>
    </nav>

    <h2 id={anchors.originals}>{tr('shop.originals')}</h2>
    <p class="lede">{tr('shop.originalsIntro')} <a href={routes.returns[lang]}>{tr('shop.policy')}</a></p>
    {forSale.length ? (
      <div class="grid">
        {forSale.map((art) => <ArtworkCard lang={lang} art={art} href={itemPaths(art.slug)[lang]} />)}
      </div>
    ) : (
      <p>{tr('shop.empty')}</p>
    )}

    <h2 id={anchors.products}>{tr('shop.prints')}</h2>
    <p class="lede">{tr('shop.printsIntro')}</p>
    <div class="grid">
      {products.filter((product) => !product.hidden).map((product) => (
        <ProductCard lang={lang} product={product} href={itemPaths(product.slug)[lang]} />
      ))}
    </div>
  </section>
)}

{page === 'about' && (
  <section class="wide">
    <h1 class="sr-only">{tr('about.title')}</h1>
    <!-- Same layout as the old site: photo 10/12 columns, text 8/12, justified. -->
    <div class="layout">
      <div class="cell" style="--col: 2 / 12">
        <figure class="view">
          <img src={site.aboutPhoto.image} alt={site.aboutPhoto.caption[lang]} decoding="async" />
          <figcaption>{site.aboutPhoto.caption[lang]}</figcaption>
        </figure>
      </div>
      <div class="cell essays" style="--col: 3 / 11">
        {site.about[lang].map((para) => <p class="essay">{para}</p>)}
      </div>
    </div>
  </section>
)}

{page === 'bio' && (
  <section class="wide">
    <h1 class="sr-only">{tr('bio.title')}</h1>
    <!-- Same layout as the old site: photo 10/12 columns, text 8/12, justified,
         the quote in light italic after the first paragraph, CV as a plain link. -->
    <div class="layout">
      <div class="cell" style="--col: 2 / 12">
        <figure class="view">
          <img src={site.bioPhoto} alt={site.artistName} decoding="async" />
        </figure>
      </div>
      <div class="cell essays" style="--col: 3 / 11">
        <h2 class="person">{site.artistName}</h2>
        {site.bio[lang].map((para, i) => (
          <>
            <p class="essay">{para}</p>
            {i === 0 && <p class="essay quote">{site.bioQuote[lang]}</p>}
          </>
        ))}
        <p class="cv">
          <a href={site.cv[lang]} target="_blank" rel="noopener">{tr('bio.cv')}</a> {tr('bio.cvNote')}
        </p>
      </div>
    </div>
  </section>
)}

{(page === 'privacy' || page === 'returns') && (() => {
  // Legal pages (privacy.json, returns.json). Fills in {company}, {cnpj} and {email} from site.json.
  const fill = (text: string) =>
    text.replaceAll('{company}', site.company.name).replaceAll('{cnpj}', site.company.cnpj).replaceAll('{email}', site.email);
  const doc = (page === 'privacy' ? privacy : returns)[lang];
  return (
    <section class="wide">
      <div class="layout">
        <div class="cell legal" style="--col: 3 / 11">
          <h1>{doc.title}</h1>
          <p class="updated">{doc.updated}</p>
          {doc.sections.map((section) => (
            <>
              <h2>{section.h}</h2>
              {section.p?.map((para) => <p>{fill(para)}</p>)}
              {section.li && <ul>{section.li.map((item) => <li>{fill(item)}</li>)}</ul>}
              {section.p2?.map((para) => <p>{fill(para)}</p>)}
            </>
          ))}
        </div>
      </div>
    </section>
  );
})()}

{page === 'contact' && (
  <section class="prose">
    <h1>{tr('contact.title')}</h1>
    <p class="lede">{tr('contact.intro')}</p>
    <form class="contact" action={site.contactFormAction} method="post">
      <label>{tr('contact.name')}<input name="name" required autocomplete="name" /></label>
      <label>{tr('contact.email')}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{tr('contact.message')}<textarea name="message" rows="6" required></textarea></label>
      <input type="hidden" name="_language" value={lang} />
      <button type="submit">{tr('contact.send')}</button>
    </form>
  </section>
)}

<style>
  .lede { color: var(--muted); font-size: 1.15rem; margin: 0 0 2rem; }
  h2 { margin-top: 2.5rem; }
  .grid { columns: 3 18rem; column-gap: 2rem; margin-bottom: 1.5rem; }
  .prose { max-width: 40rem; }

  /* Obras: 12-column grid like the old site. Each cell's columns come from obras.json. */
  .obras, .wide { max-width: 80rem; margin: 0 auto; }
  .wide .layout { row-gap: 4rem; } /* Sobre and Bio: a bit more air between photo and text */
  .layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2rem); row-gap: 3rem; align-items: start; }
  .cell { grid-column: var(--col); }
  .chapter { text-align: center; font-size: clamp(1.6rem, 3.5vw, 2.25rem); margin: 3rem 0 0.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .cell:first-child .chapter { margin-top: 0; padding-top: 0; border-top: 0; }
  .obras h3 { text-align: center; font-size: 1.15rem; margin: 1.5rem 0 0; }
  .essay { max-width: none; text-align: justify; hyphens: auto; margin: 0; }
  .essays { display: grid; gap: 1.1em; }
  .person { margin: 0; }
  /* Extra margin doubles the space above and below the quote (on top of the 1.1em gap). */
  .quote { font-style: italic; font-weight: 300; color: var(--muted); margin: 1.1em 0; }
  .cv { margin: 1.6em 0 0; }
  /* Privacy policy: readable column, plain lists. */
  .legal h1 { margin-bottom: 0.25rem; }
  .legal .updated { color: var(--muted); font-size: 0.9rem; margin: 0 0 2rem; }
  .legal h2 { font-size: 1.2rem; margin: 2.25rem 0 0.75rem; }
  .legal p, .legal li { max-width: none; }
  .legal ul { padding-left: 1.2rem; margin: 0 0 1rem; }
  .legal li { margin-bottom: 0.5rem; } /* set apart from the bio text */
  .cv a { color: inherit; }
  .view { margin: 0; }
  .view img { width: 100%; box-shadow: 0 1px 0 var(--line); }
  .view figcaption { padding-top: 0.6rem; font-size: 0.9rem; color: var(--muted); }
  .obras .cell :global(.art) { margin: 0; }
  /* Phones: one column, everything full width, in the same order. */
  @media (max-width: 40rem) {
    .cell { grid-column: 1 / -1; }
  }
  .contact { display: grid; gap: 1rem; }
  .contact label { display: grid; gap: 0.35rem; font-weight: 500; }
  .contact button { justify-self: start; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.5rem 0 1rem; }
  h2[id] { scroll-margin-top: 1.5rem; }

  /* Cover: two works side by side, the statement across the full width, two more works. */
  .cover {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem); /* space between the cover pictures (and the quote) */
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'f1 f2' 'text text' 'f3 f4';
    align-items: center;
  }
  .f1 { grid-area: f1; } .f2 { grid-area: f2; } .f3 { grid-area: f3; } .f4 { grid-area: f4; }
  /* Phones: each picture button takes the full width: OBRAS, SOBRE, quote, BIO, LOJA. */
  @media (max-width: 40rem) {
    .cover { grid-template-columns: 1fr; grid-template-areas: 'f1' 'f2' 'text' 'f3' 'f4'; }
    .tile span { font-size: 1.35rem; }
  }
  .statement { grid-area: text; padding: 1rem 0; text-align: center; }
  .statement .lede { margin-left: auto; margin-right: auto; }
  .statement h1 {
    font-size: clamp(1.44rem, 2.944vw, 2.72rem); /* reduced 20% twice from the first version */
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-stretch: 75%;
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
    font-style: italic; /* it's a quote */
    color: var(--link); /* grey, lighter in dark mode */
  }
  .quote-block { margin: 0 auto 1.5rem; }
  .statement h1 { text-wrap: balance; }
  /* Subtitle stretched to the quote's width: justified, including its last (only) line. */
  .statement .lede { margin: 0 auto; } /* centred */
  /* Phones: the subtitle on two balanced lines. */
  @media (max-width: 40rem) {
    .statement .lede { max-width: 17em; text-wrap: balance; }
  }
  /* Picture buttons: square photo with the section name on a white band across the middle. */
  .tile { position: relative; display: block; text-decoration: none; }
  .tile img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; box-shadow: 0 1px 0 var(--line); }
  .tile span {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.55em 0;
    background: rgb(255 255 255 / 0.78);
    color: var(--button); /* same dark grey as the buttons */
    text-align: center;
    font-size: clamp(1rem, 2.6vw, 1.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    text-indent: 0.25em; /* balances the letter-spacing so the word stays centred */
    transition: background 0.15s, color 0.15s;
  }
  /* Hover: see-through medium grey band, white text. Lower 0.8 for more see-through,
     but below about 0.7 the white text gets hard to read over bright pictures. */
  .tile:hover span, .tile:focus-visible span { background: rgb(138 141 145 / 0.8); color: #fff; }
</style>
