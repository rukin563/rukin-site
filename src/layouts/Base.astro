---
import { routes, t, type Lang, type PageKey } from '../i18n/ui';
import site from '../data/site.json';

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  // Only for pages that aren't in the routes map (like each shop item): their URL in both languages.
  paths?: Record<Lang, string>;
  description?: string;
  image?: string; // preview picture when the link is shared on WhatsApp, Instagram, etc.
  minimal?: boolean; // landing pages: no menu, small name, so nothing distracts from the offer
}

const { lang, page, title, paths = routes[page], description, image, minimal = false } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const pageTitle = title ? `${title} — ${site.artistName}` : site.artistName;
const metaDescription = description ?? tr('site.description');
const canonical = new URL(paths[lang], Astro.site);
const alternate = new URL(paths[other], Astro.site);
const nav: PageKey[] = ['home', 'gallery', 'about', 'bio', 'shop', 'contact'];
const year = new Date().getFullYear();
const banner = page === 'home' ? site.bannerImage : null;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <!-- Tells Google both language versions exist, so each one gets indexed. -->
    <link rel="alternate" hreflang={lang === 'pt' ? 'pt-BR' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'pt' ? 'pt-BR' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.pt, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..800;1,62..125,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="app" data-page={page}>
      <header class:list={['masthead', { minimal }]}>
        <a class="name" href={routes.home[lang]}>{site.artistName}</a>
        {!minimal && (
          <button class="burger" type="button" aria-expanded="false" aria-controls="site-menu" data-burger>
            <span class="sr-only">{tr('nav.menu')}</span>
            <span class="bars" aria-hidden="true"></span>
          </button>
        )}
        {!minimal && (
          <nav id="site-menu" aria-label="Principal">
            {nav.map((key) => (
              <a href={routes[key][lang]} aria-current={key === page ? 'page' : undefined}>
                {tr(`nav.${key}`)}
              </a>
            ))}
          </nav>
        )}
        <!-- A real link, so it works even with JavaScript off and Google can follow it.
             The script below turns it into an instant swap without a page reload. -->
        <a
          class="lang"
          href={paths[other]}
          hreflang={other}
          data-lang-toggle
          aria-label={tr('lang.switch')}
        >
          <span class:list={{ on: lang === 'pt' }}>PT</span>
          <span class:list={{ on: lang === 'en' }}>EN</span>
        </a>
      </header>

      <!-- Cover only: full-width banner photo under the menu, with the name on it, like the old site.
           The photo is "bannerImage" in site.json; set it to null to remove the banner. -->
      {banner && (
        <div class="banner" style={`--banner: url('${banner}')`}>
          <p class="banner-name">{site.artistName}</p>
        </div>
      )}

      <main>
        <slot />
      </main>

      <footer>
        {/* Hidden until "newsletterAction" in site.json is a real provider address (not a SEU_ placeholder). */}
        {/* Sends to the Brevo form "Site rukin563.com" (list "Newsletter site", double opt-in).
             With JavaScript the visitor stays on the page; without it, Brevo's own page opens. */}
        {!site.newsletterAction.includes('SEU_') && (
        <form
          class="newsletter"
          action={site.newsletterAction}
          method="post"
          data-newsletter
          data-thanks={tr('news.thanks')}
          data-error={tr('news.error')}
        >
          <h2>{tr('news.title')}</h2>
          <p>{tr('news.text')}</p>
          <div class="row">
            <label class="sr-only" for="news-email">{tr('contact.email')}</label>
            <input id="news-email" type="email" name="EMAIL" required autocomplete="email" placeholder={tr('news.placeholder')} />
            <button type="submit">{tr('news.button')}</button>
          </div>
          {/* Brevo's spam trap: people never see or fill it. */}
          <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />
          <input type="hidden" name="locale" value={lang} />
          <p class="news-status" role="status" data-newsletter-status></p>
        </form>
        )}
        <div class="fine">
          <span>© {year} {site.artistName}. {tr('footer.rights')}</span>
          <a href={site.instagram} rel="me">Instagram</a>
          <a href={routes.privacy[lang]}>{tr('footer.privacy')}</a>
          <a href={routes.returns[lang]}>{tr('shop.policy')}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </footer>
    </div>

    <script>
      // Language switch without a full page reload.
      // Fetches the other language's page, swaps the content in place,
      // and updates the address bar so the URL is still shareable.
      const app = () => document.getElementById('app')!;

      async function swapTo(url: string, push: boolean) {
        app().classList.add('swapping');
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(String(res.status));
          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
          const next = doc.getElementById('app');
          if (!next) throw new Error('no #app');
          app().replaceWith(next);
          document.title = doc.title;
          document.documentElement.lang = doc.documentElement.lang;
          // Keep SEO tags in sync with the visible language.
          document.head.querySelectorAll('link[rel="canonical"], link[rel="alternate"], meta[name="description"]').forEach((el) => el.remove());
          doc.head.querySelectorAll('link[rel="canonical"], link[rel="alternate"], meta[name="description"]').forEach((el) => document.head.append(el));
          if (push) history.pushState({}, '', url);
          try {
            localStorage.setItem('lang', doc.documentElement.lang);
          } catch {}
        } catch {
          location.href = url; // fall back to a normal page load
        }
      }

      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('[data-lang-toggle]');
        if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        swapTo(link.href, true);
      });

      window.addEventListener('popstate', () => swapTo(location.href, false));

      // Phone menu (☰): open and close. Listens on the document so it keeps
      // working after the PT/EN switch swaps the page.
      function setMenu(open: boolean) {
        document.querySelector('[data-burger]')?.setAttribute('aria-expanded', String(open));
        document.getElementById('site-menu')?.classList.toggle('open', open);
      }
      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        const burger = target.closest('[data-burger]');
        if (burger) return setMenu(burger.getAttribute('aria-expanded') !== 'true');
        if (!target.closest('#site-menu')) setMenu(false); // tap outside closes it
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // Newsletter: send to Brevo in the background and show the answer under the form.
      document.addEventListener('submit', async (e) => {
        const form = e.target as HTMLFormElement;
        if (!form.matches('[data-newsletter]')) return;
        e.preventDefault();
        const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        button.disabled = true;
        try {
          const data = new FormData(form);
          data.append('isAjax', '1');
          const res = await fetch(form.action, { method: 'POST', body: data });
          const json = await res.json();
          if (!res.ok || !json.success) throw new Error();
          status.textContent = form.dataset.thanks!;
          form.reset();
        } catch {
          status.textContent = form.dataset.error!;
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --wall: #e4e5e1;      /* concrete grey, the "gallery wall" */
    --paper: #f3f3f0;     /* raised surfaces: forms, cards */
    --ink: #333333;       /* text: dark grey, 80% black */
    --muted: #5e636b;
    --line: #c4c6c1;
    --link: #5a5d62;      /* links and grey text accents (same grey as the buttons) */
    --link-hover: #8a8d91;
    --button: #5a5d62;    /* all buttons: dark grey... */
    --button-hover: #8a8d91; /* ...lightening on hover */
    --sold: #9a3b2e;
    --gutter: clamp(16px, 4vw, 48px);
    --font: 'Archivo', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --wall: #1d1f22;
      --paper: #26292d;
      --ink: #ecece8;
      --muted: #a2a6ad;
      --line: #3a3e44;
      --link: #b4b7bc;      /* lighter in dark mode so links stay readable */
      --link-hover: #e2e4e7;
      --sold: #e58a7b;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  /* Links that jump down the page land below the sticky menu bar, not under it. */
  html { scroll-padding-top: 6rem; }
  @media (max-width: 40rem) { html { scroll-padding-top: 5rem; } }
  body {
    margin: 0;
    background: var(--wall);
    color: var(--ink);
    font-family: var(--font);
    font-variation-settings: 'wdth' 100;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--link); text-underline-offset: 0.2em; }
  :focus-visible { outline: 3px solid var(--link); outline-offset: 3px; }
  h1, h2, h3 { line-height: 1.1; margin: 0 0 0.5em; font-weight: 700; }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-variation-settings: 'wdth' 118; font-stretch: 118%; letter-spacing: -0.01em; }
  h2 { font-size: 1.5rem; font-variation-settings: 'wdth' 110; }
  p { max-width: 62ch; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  #app { min-height: 100vh; display: flex; flex-direction: column; transition: opacity 0.15s; }
  #app.swapping { opacity: 0.4; }
  @media (prefers-reduced-motion: reduce) { #app { transition: none; } }

  /* Masthead: one row. Menu on the left; the name and the PT/EN switch on the right.
     On phones the menu wraps onto its own row below. */
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'nav name lang';
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 1.25rem var(--gutter);
    border-bottom: 1px solid var(--line);
    /* Stays at the top while scrolling; solid background so the page doesn't show through. */
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--wall);
  }
  .name {
    grid-area: name;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    padding: 0.25rem 0;
  }
  .masthead nav { grid-area: nav; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .masthead nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 0.25rem 0; }
  .masthead nav a:hover { color: var(--link-hover); }
  a:hover { color: var(--link-hover); }
  .masthead nav a[aria-current='page'] { color: var(--link); text-decoration: underline; text-decoration-thickness: 2px; }

  /* Phone rules come after the general menu rules above, so they win. */
  .burger { display: none; }
  /* Phones: the menu folds into a ☰ button on the left; tapping it opens the menu as a list under the bar. */
  @media (max-width: 40rem) {
    .masthead { grid-template-columns: auto 1fr auto auto; grid-template-areas: 'burger . name lang'; }
    .burger {
      grid-area: burger;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      margin-left: -0.5rem;
      padding: 0;
      background: none;
      color: var(--ink);
    }
    .burger:hover { background: none; color: var(--link-hover); }
    .bars, .bars::before, .bars::after {
      display: block;
      width: 1.4rem;
      height: 2px;
      background: currentColor;
      transition: transform 0.2s, opacity 0.2s;
    }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -7px; }
    .bars::after { top: 7px; }
    /* Open: the three bars turn into an X. */
    .burger[aria-expanded='true'] .bars { background: transparent; }
    .burger[aria-expanded='true'] .bars::before { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded='true'] .bars::after { transform: translateY(-7px) rotate(-45deg); }

    .masthead nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
      background: var(--wall);
      border-bottom: 1px solid var(--line);
    }
    .masthead nav.open { display: flex; }
    .masthead nav a { padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
    .masthead nav a:last-child { border-bottom: 0; }
    .masthead.minimal { grid-template-columns: 1fr auto auto; } /* landing pages: no ☰, name and switch on the right */
  }

  .lang {
    grid-area: lang;
    display: inline-flex;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 3px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .lang span { padding: 0.3rem 0.7rem; border-radius: 999px; color: var(--ink); }
  .lang span.on { background: var(--ink); color: var(--wall); }

  /* Landing pages: no menu, just the name and the switch on the right. */
  .masthead.minimal { grid-template-areas: '. name lang'; }

  /* Cover banner: 430px tall like the old site (250px on phones). The light dark layer
     keeps the white name readable on bright photos; raise 0.3 if it gets hard to read. */
  .banner {
    display: grid;
    place-items: center;
    height: 430px;
    background: linear-gradient(rgb(0 0 0 / 0.3), rgb(0 0 0 / 0.3)), var(--banner) center / cover no-repeat, #3a3d40;
  }
  @media (max-width: 30rem) { .banner { height: 250px; } }
  .banner-name {
    margin: 0;
    color: #fff;
    font-weight: 800;
    font-variation-settings: 'wdth' 62;
    font-stretch: 62%;
    font-size: clamp(3.5rem, 12vw, 8rem);
    line-height: 1;
    text-transform: lowercase;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.35);
  }

  main { flex: 1; padding: clamp(2rem, 5vw, 4rem) var(--gutter); }

  footer { border-top: 1px solid var(--line); padding: 2.5rem var(--gutter); display: grid; gap: 2rem; }
  .newsletter h2 { margin-bottom: 0.25rem; font-size: 1.35rem; } /* 10% smaller than other h2 */
  /* Newsletter email field and Assinar button: 10% smaller than the standard ones. */
  .newsletter .row { max-width: 27rem; }
  .newsletter .row input, .newsletter .row button { font-size: 0.9em; }
  .newsletter .row input { padding: 0.585rem 0.72rem; }
  .newsletter .row button { padding: 0.585rem 0.99rem; }
  .newsletter p { color: var(--muted); margin: 0 0 1rem; }
  .newsletter .news-status { margin: 0.75rem 0 0; color: var(--ink); min-height: 1.5em; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; }
  /* Darker grey at rest, lightening to the cover's hover grey, so the hover is easy to see. */
  .row { display: flex; gap: 0.5rem; flex-wrap: wrap; max-width: 30rem; }
  input, textarea {
    font: inherit; color: var(--ink); background: var(--paper);
    border: 1.5px solid var(--line); border-radius: 6px; padding: 0.65rem 0.8rem; width: 100%;
  }
  .row input { flex: 1 1 14rem; width: auto; }
  button, .button {
    font: inherit; font-weight: 600; cursor: pointer;
    background: var(--button); color: #fff; border: 0; border-radius: 6px; transition: background 0.15s, color 0.15s;
    padding: 0.65rem 1.1rem; text-decoration: none; display: inline-block;
  }
  button:hover, .button:hover { background: var(--button-hover); color: #fff; } /* white text stays white on hover */
  .button.quiet { background: transparent; color: var(--link); border: 1.5px solid currentColor; }
  .button.quiet:hover { background: transparent; color: var(--link-hover); }
  .fine { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.875rem; color: var(--muted); }
  .fine a { color: var(--muted); }
</style>
